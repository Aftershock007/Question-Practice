{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "auth.js",
    "prompt.js",
    "schedule_data.js",
    "app.js",
    "ai_config.js",
    "answer-marks.js",
    "ai_eval.js",
    "objective_ai.js",
    "descriptive_ai.js",
    "calendar.js",
    "folders.js",
    "globals.d.ts"
  ],
  "exclude": [
    "vendor",
    "node_modules",
    ".playwright-mcp"
  ]
}
